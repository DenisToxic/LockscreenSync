<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lockscreen"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:textColor="#212529"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:fontFamily="sans-serif-medium"
            android:text="Drawing Sync"
            android:textColor="#6C757D"
            android:textSize="18sp" />

        <!-- Room Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIVATE ROOM"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ADB5BD"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvCurrentRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Room: test-room"
                android:textSize="20sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:textColor="#343A40"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnCreateRoom"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create New Room"
                android:background="@drawable/modern_button_bg"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etRoomId"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="Enter Code"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="4dp"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Join"
                    android:background="@drawable/outline_button_bg"
                    android:textColor="#4361EE"
                    android:paddingHorizontal="16dp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Wallpaper Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPEARANCE"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ADB5BD"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnPickBg"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Set Custom Wallpaper"
                android:background="@drawable/light_button_bg"
                android:textColor="#212529"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnRemoveBg"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Use Phone Wallpaper"
                android:background="@drawable/light_button_bg"
                android:textColor="#6C757D"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenLock"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Preview Lockscreen"
            android:background="@drawable/dark_button_bg"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:elevation="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: Enable 'Display over other apps' and remove your system screen lock for the best experience."
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textColor="#ADB5BD"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>