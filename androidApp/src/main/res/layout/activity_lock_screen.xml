<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Lockscreen Background" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="84sp"
            android:fontFamily="sans-serif-thin"
            android:shadowColor="#88000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, d MMMM"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-light"
            android:textAllCaps="true"
            android:shadowColor="#88000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <dev.hytalpioneers.lockscreen.DrawView
        android:id="@+id/drawView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/notificationsScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/selectionPanels"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="24dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/notificationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        </LinearLayout>
    </ScrollView>

    <!-- Floating Selection Panels -->
    <LinearLayout
        android:id="@+id/selectionPanels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/controlsLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sizePickerPanel"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:backgroundTint="#CC000000"
            android:padding="16dp"
            android:visibility="gone"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brush Size"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />
            <SeekBar
                android:id="@+id/sizeSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="8"
                android:max="50"
                android:thumb="@drawable/slider_thumb"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF"
                android:splitTrack="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/colorPickerPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:backgroundTint="#CC000000"
            android:padding="12dp"
            android:visibility="gone"
            android:orientation="horizontal"
            android:gravity="center">
            <View android:id="@+id/colorWhite" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle" android:backgroundTint="#FFFFFF" android:layout_margin="8dp" />
            <View android:id="@+id/colorRed" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle" android:backgroundTint="#FF0000" android:layout_margin="8dp" />
            <View android:id="@+id/colorGreen" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle" android:backgroundTint="#00FF00" android:layout_margin="8dp" />
            <View android:id="@+id/colorBlue" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle" android:backgroundTint="#0000FF" android:layout_margin="8dp" />
            <View android:id="@+id/colorYellow" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle" android:backgroundTint="#FFFF00" android:layout_margin="8dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnColorSelect"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/round_button_bg"
            android:drawableTop="@android:drawable/ic_menu_edit"
            android:paddingTop="14dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnSizeSelect"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/round_button_bg"
            android:text="SIZE"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/round_button_bg"
            android:text="CLR"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/unlockButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="120dp"
            android:background="@drawable/round_button_bg"
            android:backgroundTint="#FFFFFF"
            android:text="UNLOCK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingHorizontal="24dp" />
    </LinearLayout>

</RelativeLayout>